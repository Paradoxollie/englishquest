              },
              {
                id: 8,
                question: "This is ___ university.",
                options: ["an", "a", "the", "Ø"],
                correctAnswer: 1,
                explanation: "Son consonne ('You'). Donc A University.",
              },
              {
                id: 9,
                question: "___ dogs are faithful.",
                options: ["The", "A", "An", "Ø"],
                correctAnswer: 3,
                explanation: "Généralité sur les chiens. Pas de 'The'.",
