              {
                id: 10,
                question: "Pass me ___ salt, please.",
                options: ["a", "an", "the", "Ø"],
                correctAnswer: 2,
                explanation: "Celui qui est sur la table (spécifique). ➔ THE.",
              },
            ]}
          />
        )
      }
    ]
  },

